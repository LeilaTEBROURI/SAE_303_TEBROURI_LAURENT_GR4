---
import Layout from "../layouts/Layout.astro";
import CarteEnquete from "../components/CarteEnquete.astro";
import indicateurs from "../assets/indicateurs.json";
const quartier = indicateurs.find((q) => q.code_qp === "QN03317M")!;
const format = (n: number) =>
  n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });
---

<Layout title="Génicart Est · Le dossier sous la lumière">
  <div class="trial-scene" data-lit="true">
    <img
      class="trial-beam"
      src="/illustrations/faisceau.svg"
      width="1056"
      height="1011"
      alt=""
      aria-hidden="true"
    />
    <div class="trial-thief" aria-hidden="true">
      <img
        class="peeking-thief"
        src="/illustrations/voleur-original.svg"
        width="135"
        height="173"
        alt=""
      />
      <img
        class="peeking-hand hand-one"
        src="/illustrations/main-haute.svg"
        width="33"
        height="48"
        alt=""
      />
      <img
        class="peeking-hand hand-two"
        src="/illustrations/main-basse.svg"
        width="33"
        height="48"
        alt=""
      />
    </div>
    <div class="trial-tape" aria-hidden="true">
      <img src="/illustrations/ruban.webp" width="733" height="916" alt="" />
    </div>
    <button
      class="trial-torch"
      type="button"
      aria-pressed="true"
      aria-label="Éteindre la torche"
      id="torch-switch"
    >
      <span class="torch-drawing" aria-hidden="true">
        <img src="/illustrations/torche.svg" width="366" height="280" alt="" />
        <span class="torch-switch-track">
          <span></span>
        </span>
      </span>
      <span class="torch-instruction">
        <span class="torch-dot"></span>
        <span id="torch-label">Torche allumée</span>
      </span>
    </button>
    <div class="trial-content">
      <div class="trial-toolbar">
        <a href={`/quartiers/${quartier.code_qp}/`}>
          ← Voir la version actuelle
        </a>
        <span class="trial-edition">ENQUÊTE DE TERRAIN / 12</span>
      </div>
      <header class="trial-heading">
        <p class="trial-kicker">Qui a volé l’ombre ?</p>
        <h1>
          Génicart Est<span class="trial-heading-dot">.</span>
        </h1>
        <p>Lormont · Sur la piste de la fraîcheur</p>
        <span class="trial-case-stamp">DOSSIER OUVERT</span>
      </header>
      <article class="trial-file" data-dossier={quartier.code_qp}>
        <div class="file-tab">LES PIÈCES DU DOSSIER</div>
        <div class="file-topline">
          <span class="typewriter">N° 12 / QN03317M</span>
          <span class="file-date">CHALEUR · 11 JUILLET 2022</span>
        </div>
        <section class="trial-metrics" aria-label="Les trois premiers indices">
          <article>
            <p class="trial-index">INDICE 01 — CHALEUR</p>
            <strong class="hot-text">
              {format(quartier.part_chaude_pct)}
              <span> %</span>
            </strong>
            <h2>de surface chaude</h2>
            <p>dans le quartier</p>
          </article>
          <article>
            <p class="trial-index">INDICE 02 — LIEUX</p>
            <strong class="green-text" id="trial-vegetation">
              {quartier.nombre_lieux_frais}
              <span> lieux</span>
            </strong>
            <h2>ponctuels recensés</h2>
            <p class="trial-distance">dans le QPV ou à moins de 300 m</p>
          </article>
          <article>
            <p class="trial-index">INDICE 03 — EAU</p>
            <strong class="blue-text" id="trial-water">
              {quartier.comptes_300m["Eau et rafraîchissement"]}
              <span> lieux d’eau</span>
            </strong>
            <h2>recensés</h2>
            <p class="trial-distance">dans le QPV ou à moins de 300 m</p>
          </article>
        </section>
        <div class="trial-map-heading">
          <span class="typewriter">LA SCÈNE À EXAMINER</span>
          <p>Superpose les indices et explore les alentours.</p>
        </div>
        <CarteEnquete code={quartier.code_qp} detail />
        <section class="trial-note">
          <span class="note-pin" aria-hidden="true"></span>
          <p class="typewriter">CE QU’ON RETIENT</p>
          <h2>Un quartier largement classé chaud.</h2>
          <p>
            <strong>{format(quartier.part_chaude_pct)} %</strong> de sa surface
            est classée chaude.{" "}
            <span id="trial-interpretation" data-lieux-interpretation>
              {quartier.nombre_lieux_frais} lieux ponctuels sont retenus à 300
              m. Les parcs surfaciques sont exclus de ce comptage, comme dans le
              notebook.
            </span>
          </p>
          <p class="note-caution">
            À vérifier sur place : entrées, accès et horaires. Les données ne
            mesurent pas directement l’ombre.
          </p>
        </section>
        <footer class="trial-file-footer">
          <span class="trial-consulted">
            <img
              src="/illustrations/empreinte.webp"
              width="25"
              height="34"
              alt=""
            />
            Pièces consultées
          </span>
          <a href="/sources/">Vérifier les sources et la méthode ↗</a>
        </footer>
      </article>
      <nav class="trial-next" aria-label="Suite de l’enquête">
        <a href="/#dossiers">← Les 23 dossiers</a>
        <p>Chaque quartier a ses indices.</p>
        <a href="/carte/">Revenir sur le terrain ↗</a>
      </nav>
    </div>
  </div>
</Layout>
<script src="../scripts/dossier.ts"></script>
<script>
  const scene = document.querySelector<HTMLElement>(".trial-scene")!;
  const button = document.querySelector<HTMLButtonElement>("#torch-switch")!;
  button.addEventListener("click", () => {
    const lit = button.getAttribute("aria-pressed") !== "true";
    button.setAttribute("aria-pressed", String(lit));
    button.setAttribute(
      "aria-label",
      lit ? "Éteindre la torche" : "Allumer la torche",
    );
    scene.dataset.lit = String(lit);
    document.querySelector("#torch-label")!.textContent = lit
      ? "Torche allumée"
      : "Allumer la torche";
  });
</script>
<style>
  :global(astro-dev-toolbar) {
    display: none;
  }
  .trial-scene {
    position: relative;
    isolation: isolate;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    padding: 12px 0 45px;
    color: #2f2f2f;
    min-height: 1300px;
  }
  .trial-beam {
    position: absolute;
    z-index: -2;
    width: 1550px;
    max-width: none;
    height: auto;
    top: -90px;
    left: calc(50% - 850px);
    pointer-events: none;
    transition: opacity 0.5s;
  }
  .trial-content {
    position: relative;
    width: min(1080px, calc(100% - 300px));
    margin-left: max(190px, calc((100% - 1080px) / 2 + 55px));
    z-index: 2;
  }
  .trial-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 0 35px;
    font-size: 11px;
    letter-spacing: 0.02em;
  }
  .trial-toolbar > a {
    color: #fffbee;
    text-decoration: none;
    background: #2f2f2f;
    border: 1px solid #77746b;
    padding: 9px 14px;
    border-radius: 24px;
  }
  .trial-edition {
    background: #2f2f2f;
    color: #bab6ab;
    padding: 6px 10px;
    border-radius: 20px;
    font-family: "Special Elite", monospace;
    letter-spacing: 0.08em;
    font-size: 11px;
  }
  .trial-heading {
    position: relative;
    padding: 6px 0 62px 25px;
  }
  .trial-kicker {
    font-family: "Special Elite", monospace;
    text-transform: uppercase;
    font-size: 16px;
    letter-spacing: 0.1em;
    margin-bottom: 10px;
  }
  .trial-heading h1 {
    font-size: clamp(40px, 5vw, 70px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.045em;
    margin: 0 0 15px;
  }
  .trial-heading-dot {
    color: #bd582d;
  }
  .trial-heading > p:last-of-type {
    font-size: 16px;
  }
  .trial-case-stamp {
    background: #fffbee;
    position: absolute;
    right: 36px;
    top: 65px;
    transform: rotate(-9deg);
    border: 2px solid #a73d30;
    color: #a73d30;
    font-family: "Special Elite", monospace;
    font-size: 15px;
    letter-spacing: 0.06em;
    padding: 9px 13px;
  }
  .trial-file {
    position: relative;
    background: #fffbee;
    border: 9px solid #c49e4b;
    border-radius: 2px 9px 9px 9px;
    box-shadow: 8px 10px 0 #00000016;
    padding: 25px 27px 20px;
    transition: filter 0.5s;
  }
  .file-tab {
    position: absolute;
    left: -9px;
    top: -38px;
    border-radius: 10px 10px 0 0;
    background: #c49e4b;
    padding: 9px 20px 8px;
    color: #2f2f2f;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.15em;
  }
  .file-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #d7cebb;
    padding-bottom: 15px;
    margin-bottom: 24px;
  }
  .file-topline .typewriter {
    font-size: 11px;
  }
  .file-date {
    font-size: 9px;
    letter-spacing: 0.12em;
    color: #6c6658;
  }
  .trial-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }
  .trial-metrics article {
    border-right: 1px solid #d7cebb;
    padding-right: 15px;
  }
  .trial-metrics article:last-child {
    border: 0;
  }
  .trial-index {
    font-family: "Special Elite", monospace;
    letter-spacing: 0.04em;
    font-size: 10px;
    margin-bottom: 13px;
    color: #736c5b;
  }
  .trial-metrics strong {
    font-size: 42px;
    font-weight: 700;
    letter-spacing: -0.04em;
    display: block;
    line-height: 1.15;
    margin-bottom: 8px;
  }
  .trial-metrics strong span {
    margin-left: 0.15em;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .trial-metrics h2 {
    font-size: 14px;
    font-weight: 600;
  }
  .trial-metrics article > p:last-child {
    font-size: 10px;
    color: #696353;
    margin-top: 3px;
  }
  .trial-map-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 0;
    border-block: 1px solid #d7cebb;
  }
  .trial-map-heading .typewriter {
    font-size: 12px;
  }
  .trial-map-heading > p {
    font-size: 11px;
    color: #696353;
  }
  .trial-scene :global(.detail-explorer) {
    margin-top: 18px;
    margin-bottom: 12px;
  }
  .trial-scene :global(.detail-explorer > .section-head) {
    display: none;
  }
  .trial-scene :global(.map-layout) {
    grid-template-columns: minmax(0, 1.7fr) minmax(230px, 1fr);
    gap: 16px;
  }
  .trial-scene :global(.detail-explorer .leaflet-map) {
    height: 390px;
  }
  .trial-scene :global(.selected-panel) {
    padding: 18px;
    gap: 14px;
    border: 1px solid #e8dfc8;
  }
  .trial-scene :global(.selected-panel > .eyebrow) {
    display: none;
  }
  .trial-scene :global(.layer-pill) {
    font-size: 10px;
    padding: 9px;
  }
  .trial-scene :global(.map-controls) {
    margin-bottom: 14px;
  }
  .trial-scene :global(.map-legend) {
    font-size: 9px;
    margin-top: 14px;
    gap: 11px;
  }
  .trial-scene :global(.map-source) {
    font-size: 9px;
    margin-top: 10px;
  }
  .trial-scene :global(.map-hint) {
    font-size: 9px;
  }
  .trial-scene :global(.counts) {
    font-size: 11px;
  }
  .trial-scene :global(.panel-note) {
    font-size: 9px;
  }
  .trial-note {
    position: relative;
    padding: 20px 24px 18px;
    margin: 26px 7px 25px;
    background: #f5e6b7;
    box-shadow: 3px 4px 0 #c8b88138;
    transform: rotate(-0.6deg);
  }
  .note-pin {
    position: absolute;
    top: -8px;
    left: 45%;
    width: 82px;
    height: 20px;
    background: #e3d7b288;
    transform: rotate(5deg);
  }
  .trial-note > .typewriter {
    font-size: 10px;
    color: #8d522d;
    margin-bottom: 8px;
  }
  .trial-note h2 {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .trial-note > p {
    font-size: 12px;
  }
  .trial-note > .note-caution {
    font-size: 10px;
    margin-top: 10px;
    color: #6e6248;
  }
  .trial-file-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10px;
    padding-top: 6px;
    gap: 15px;
  }
  .trial-file-footer a {
    text-decoration: underline;
  }
  .trial-consulted {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #2c6d4b;
    font-family: "Special Elite", monospace;
  }
  .trial-consulted img {
    object-fit: contain;
  }
  .trial-next {
    color: #fffbee;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 24px;
    font-size: 11px;
  }
  .trial-next p {
    color: #777061;
  }
  .trial-next a {
    text-decoration: underline;
  }
  .trial-thief {
    position: absolute;
    left: -43px;
    top: 90px;
    width: 135px;
    height: 280px;
    z-index: 4;
    pointer-events: none;
  }
  .peeking-thief {
    position: absolute;
    left: 0;
    top: 40px;
  }
  .peeking-hand {
    position: absolute;
    left: 42px;
  }
  .hand-one {
    top: 0;
  }
  .hand-two {
    top: 218px;
    transform: scaleY(-1);
  }
  .trial-tape {
    position: absolute;
    right: -130px;
    top: -110px;
    width: 380px;
    height: 230px;
    overflow: hidden;
    transform: rotate(30deg);
    z-index: 5;
    pointer-events: none;
  }
  .trial-tape img {
    position: absolute;
    width: 380px;
    height: auto;
    max-width: none;
    top: -235px;
    left: 0;
  }
  .trial-torch {
    position: fixed;
    left: -83px;
    bottom: -30px;
    width: 330px;
    height: 280px;
    z-index: 5;
    cursor: pointer;
    border: none;
    background: none;
    color: #fffbee;
    transition: transform 0.2s;
  }
  .trial-torch:hover {
    transform: translate(3px, -4px);
  }
  .torch-drawing {
    position: absolute;
    left: 0;
    bottom: 0;
    display: block;
    width: 330px;
    height: 253px;
  }
  .torch-drawing > img {
    width: 330px;
    height: auto;
    max-width: none;
  }
  .torch-switch-track {
    position: absolute;
    width: 130px;
    height: 43px;
    left: 55px;
    top: 147px;
    border-radius: 30px;
    background: #000;
    transform: rotate(-33deg);
    border: 1px solid #000;
  }
  .torch-switch-track > span {
    position: absolute;
    inset: 2px 3px 2px 30px;
    background: #aaa;
    border-radius: 30px;
  }
  .torch-instruction {
    position: absolute;
    top: -12px;
    left: 122px;
    display: flex;
    gap: 8px;
    align-items: center;
    white-space: nowrap;
    font-size: 10px;
    background: #2f2f2f;
    border: 1px solid #68655e;
    border-radius: 20px;
    padding: 8px 11px;
    transform: rotate(-8deg);
  }
  .torch-dot {
    width: 6px;
    height: 6px;
    background: #f8c457;
    border-radius: 50%;
  }
  .trial-scene[data-lit="false"] .trial-beam {
    opacity: 0.08;
  }
  .trial-scene[data-lit="false"] .trial-file {
    filter: brightness(0.42);
  }
  .trial-scene[data-lit="false"] .trial-heading,
  .trial-scene[data-lit="false"] .trial-edition,
  .trial-scene[data-lit="false"] .trial-next {
    color: #fffbee;
  }
  .trial-scene[data-lit="false"] .torch-dot {
    background: #777;
  }
  @media (min-width: 1650px) {
    .trial-content {
      margin-inline: auto;
    }
    .trial-beam {
      left: calc(50% - 760px);
      width: 1660px;
    }
  }
  @media (max-width: 1100px) {
    .trial-content {
      width: calc(100% - 180px);
      margin-left: 110px;
    }
    .trial-case-stamp {
      background: #fffbee;
      font-size: 11px;
      right: 5px;
    }
    .trial-file {
      padding: 20px;
    }
    .trial-torch {
      transform: scale(0.75);
      transform-origin: left bottom;
    }
    .trial-torch:hover {
      transform: scale(0.75);
    }
    .trial-scene :global(.map-layout) {
      grid-template-columns: minmax(0, 1fr) 235px;
    }
    .trial-metrics strong {
      font-size: 34px;
    }
    .trial-metrics strong span {
      margin-left: 0.15em;
      font-size: 16px;
    }
    .trial-tape {
      right: -170px;
    }
  }
  @media (max-width: 760px) {
    .trial-scene {
      padding-top: 15px;
      min-height: 0;
    }
    .trial-content {
      width: calc(100% - 36px);
      margin-left: 18px;
    }
    .trial-toolbar {
      padding-bottom: 28px;
    }
    .trial-edition {
      background: #2f2f2f;
      color: #bab6ab;
      padding: 6px 10px;
      border-radius: 20px;
      font-size: 8px;
      max-width: 105px;
      text-align: right;
    }
    .trial-heading {
      padding: 10px 12px 66px 34px;
    }
    .trial-heading h1 {
      font-size: 46px;
    }
    .trial-kicker {
      font-size: 11px;
    }
    .trial-heading > p:last-of-type {
      font-size: 12px;
    }
    .trial-case-stamp {
      background: #fffbee;
      top: auto;
      bottom: 29px;
      right: 10px;
      font-size: 9px;
      padding: 5px 9px;
    }
    .trial-thief {
      transform: scale(0.6);
      transform-origin: left top;
      left: -32px;
      top: 88px;
    }
    .trial-tape {
      width: 160px;
      height: 90px;
      right: -80px;
      top: 5px;
    }
    .trial-tape img {
      width: 200px;
      top: -135px;
    }
    .trial-beam {
      width: 1650px;
      left: calc(50% - 740px);
      top: -10px;
      height: 2100px;
    }
    .trial-file {
      padding: 18px 13px 16px;
      border-width: 6px;
    }
    .file-tab {
      left: -6px;
      font-size: 9px;
      top: -32px;
      padding: 8px 13px;
    }
    .file-topline {
      margin-bottom: 18px;
    }
    .file-date {
      font-size: 7px;
      max-width: 100px;
      text-align: right;
    }
    .trial-metrics {
      gap: 9px;
    }
    .trial-index {
      font-size: 7px;
      line-height: 1.5;
      min-height: 22px;
      margin-bottom: 7px;
    }
    .trial-metrics article {
      padding-right: 8px;
    }
    .trial-metrics strong {
      font-size: 29px;
    }
    .trial-metrics strong span {
      margin-left: 0.15em;
      display: block;
      font-size: 12px;
      letter-spacing: 0;
      margin-top: 3px;
    }
    .trial-metrics article:first-child strong span {
      display: inline;
      font-size: 16px;
    }
    .trial-metrics h2 {
      font-size: 11px;
      line-height: 1.5;
    }
    .trial-metrics article > p:last-child {
      font-size: 8px;
      line-height: 1.5;
    }
    .trial-map-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
    .trial-scene :global(.map-layout) {
      grid-template-columns: 1fr;
    }
    .trial-scene :global(.detail-explorer .leaflet-map) {
      height: 320px;
    }
    .trial-scene :global(.layer-pill) {
      font-size: 9px;
      padding: 8px 6px;
      gap: 5px;
    }
    .trial-scene :global(.map-controls) {
      gap: 6px;
    }
    .trial-scene :global(.map-controls > [data-reset]) {
      font-size: 10px;
    }
    .trial-note {
      padding: 18px;
      margin-inline: 0;
    }
    .trial-note h2 {
      font-size: 17px;
    }
    .trial-file-footer {
      font-size: 8px;
      align-items: flex-start;
    }
    .trial-file-footer a {
      max-width: 130px;
      text-align: right;
    }
    .trial-consulted {
      gap: 5px;
    }
    .trial-next {
      font-size: 10px;
    }
    .trial-next p {
      display: none;
    }
    .trial-torch {
      position: absolute;
      left: -50px;
      bottom: -18px;
      transform: scale(0.43);
      transform-origin: left bottom;
      pointer-events: auto;
    }
    .trial-torch:hover {
      transform: scale(0.43);
    }
    .trial-next {
      margin-bottom: 115px;
    }
    .torch-instruction {
      font-size: 17px;
      top: -25px;
    }
    .trial-scene[data-lit="false"] .trial-file {
      filter: brightness(0.65);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trial-file,
    .trial-beam,
    .trial-torch {
      transition: none;
    }
  }
</style>
