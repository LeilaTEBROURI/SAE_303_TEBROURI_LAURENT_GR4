---
import { slugQuartier, adresseQuartier } from "../../utils/quartiers";
import Terme from "../../components/Terme.astro";
import ProgressionEnquete from "../../components/ProgressionEnquete.astro";
import Layout from "../../layouts/Layout.astro";
import BarriereTitre from "../../components/BarriereTitre.astro";
import CarteEnquete from "../../components/CarteEnquete.astro";
import indicateurs from "../../assets/indicateurs.json";
// Comme dans le TP6 : lire le paramètre de l’URL à chaque requête.
export const prerender = false;
const { slug } = Astro.params;
const ancienQuartier = indicateurs.find(
  (quartier) => quartier.code_qp === slug,
);
if (ancienQuartier) {
  return Astro.redirect(
    adresseQuartier(ancienQuartier) + Astro.url.search,
    301,
  );
}
const quartier = indicateurs.find(
  (quartier) => slugQuartier(quartier.quartier) === slug,
);

if (!quartier) {
  return Astro.rewrite("/404");
}

const index = indicateurs.findIndex(
  (ligne) => ligne.code_qp === quartier.code_qp,
);
const format = (n: number) =>
  n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });
---

<Layout title={`${quartier.quartier} · Qui a volé l’ombre ?`}>
  <ProgressionEnquete compact code={quartier.code_qp} />
  <a
    class="back-link inline-block text-[13px] mt-[15px] mr-0 mb-7 ml-0"
    href="/#dossiers"
  >
    ← Tous les dossiers
  </a>
  <article
    class="dossier-sheet pt-10 max-[760.001px]:pt-[22px] pr-10 max-[760.001px]:pr-[17px] pb-10 max-[760.001px]:pb-[22px] pl-10 max-[760.001px]:pl-[17px] bg-cream text-ink rounded-[12px] max-[760.001px]:[&_.typewriter]:text-[10px]"
    data-dossier={quartier.code_qp}
  >
    <div class="flex items-center justify-between gap-4">
      <p class="typewriter font-typewriter text-[13px]">
        DOSSIER {String(index + 1).padStart(2, "0")} · {quartier.code_qp}
      </p>
      <span class="consulted flex items-center gap-3 max-[760.001px]:gap-[5px] text-[11px] max-[760.001px]:text-[8px] font-semibold text-[#2c6d4b] bg-[#f6efdb] rounded-[5px] pt-[10px] max-[760.001px]:pt-[7px] pr-5 max-[760.001px]:pr-[9px] pb-[10px] max-[760.001px]:pb-[7px] pl-5 max-[760.001px]:pl-[9px] uppercase [&_img]:object-contain max-[760.001px]:[&_img]:h-[23px] max-[760.001px]:[&_img]:w-[16px]">
        <img
          src="/illustrations/empreinte.webp"
          width="22"
          height="32"
          alt=""
        />
        Dossier consulté
      </span>
    </div>
    <div class="dossier-heading [&_h1]:text-[42px] max-[760.001px]:[&_h1]:text-[32px] [&_h1]:font-bold [&_h1]:leading-[1.2] [&_h1]:mt-0 [&_h1]:mb-0 [&_h1]:mr-0 [&_h1]:ml-0 flex items-center justify-between gap-7 max-[760.001px]:gap-4 mt-5 mr-0 mb-5 ml-0 [&_.title-barrier]:w-[115px] max-[760.001px]:[&_.title-barrier]:w-[65px] [&_.title-barrier]:shrink-0">
      <h1>{quartier.quartier}</h1>
      <BarriereTitre />
    </div>
    <p class="mb-8">
      {quartier.communes} · Quartier prioritaire de la politique de la ville (
      <Terme id="qpv" />
      ), contours 2024
    </p>
    <div class="metrics detail-metrics grid grid-cols-3 max-[760.001px]:grid-cols-1 gap-5 max-[760.001px]:gap-3 mb-7 [&_strong]:block [&_strong]:text-[27px] max-[760.001px]:[&_strong]:text-[24px] min-[760.001px]:max-[1100.001px]:[&_strong]:text-[30px] [&_strong]:leading-[1.3] [&_strong]:font-bold [&_strong]:mb-[5px] [&_h2]:text-[14px] max-[1100.001px]:[&_h2]:text-[13px] [&_h2]:font-semibold [&_p]:text-[11px] [&_p]:mt-[5px] [&_article]:bg-[#f6efdb] [&_article]:pt-[22px] max-[760.001px]:[&_article]:pt-[18px] [&_article]:pr-[22px] max-[760.001px]:[&_article]:pr-[18px] [&_article]:pb-[22px] max-[760.001px]:[&_article]:pb-[18px] [&_article]:pl-[22px] max-[760.001px]:[&_article]:pl-[18px] [&_article]:rounded-[6px] max-[760.001px]:[&_.paper]:pt-[18px] max-[760.001px]:[&_.paper]:pr-[18px] max-[760.001px]:[&_.paper]:pb-[18px] max-[760.001px]:[&_.paper]:pl-[18px]">
      <article>
        <strong class="hot-text text-[#bd4f26]">
          {format(quartier.part_chaude_pct)} %
        </strong>
        <h2>
          de <Terme id="part-chaude" label="surface classée chaude" />
        </h2>
        <p>Observation du 11 juillet 2022</p>
      </article>
      <article>
        <strong class="green-text text-[#2c6d4b]" id="places-count">
          {quartier.nombre_lieux_frais}{" "}
          {quartier.nombre_lieux_frais === 1
            ? "lieu ponctuel"
            : "lieux ponctuels"}
        </strong>
        <h2>recensés à proximité</h2>
        <p class="distance-caption">Dans le QPV ou à 300 m de son contour</p>
      </article>
      <article>
        <strong class="blue-text text-[#2d7e9e]" id="water-count">
          {quartier.comptes_300m["Eau et rafraîchissement"]} lieux d’eau
        </strong>
        <h2>recensés à proximité</h2>
        <p>Ils ne remplacent pas un espace ombragé</p>
      </article>
    </div>
    <CarteEnquete code={quartier.code_qp} detail />
    <section class="interpretation bg-[#f6efdb] pt-[23px] max-[760.001px]:pt-[18px] pr-[23px] max-[760.001px]:pr-[18px] pb-[23px] max-[760.001px]:pb-[18px] pl-[23px] max-[760.001px]:pl-[18px] rounded-[6px] mt-[26px] [&_h2]:text-[20px] [&_h2]:font-bold [&_h2]:mb-2 [&_>_p]:text-[14px]">
      <h2>Ce que les indices suggèrent</h2>
      <p>
        {format(quartier.part_chaude_pct)} % de la surface du QPV est classée
        chaude.{" "}
        <span data-lieux-interpretation>
          {quartier.nombre_lieux_frais} lieux ponctuels sont recensés dans le
          QPV ou à 300 m de son contour.
        </span>
        Les parcs représentés par des <Terme id="polygone" label="polygones" />{" "}
        ne sont pas inclus dans cet effectif.
      </p>
      <p class="text-sm mt-3">
        À vérifier sur place : entrées, horaires, accès, aménagements récents et
        lieux absents de l’inventaire.
      </p>
    </section>
    <details class="collapse collapse-arrow border border-black/10 mt-6">
      <summary class="collapse-title font-semibold">
        Consulter les chiffres et leur mode de calcul
      </summary>
      <div class="collapse-content overflow-x-auto">
        <table class="table text-[12px] [&_caption]:text-left [&_caption]:text-[12px] [&_caption]:pt-3 [&_caption]:pr-3 [&_caption]:pb-3 [&_caption]:pl-3 [&_a]:underline">
          <caption>Indicateurs de{quartier.quartier}</caption>
          <tbody>
            <tr>
              <th>Superficie totale du QPV</th>
              <td>
                {format(quartier.surface_qpv_ha)}{" "}
                <Terme id="hectare" label="ha" />
              </td>
            </tr>
            <tr>
              <th>Surface chaude située dans le QPV</th>
              <td>
                {format(quartier.surface_chaude_ha)}{" "}
                <Terme id="hectare" label="ha" />
              </td>
            </tr>
            <tr>
              <th>
                <Terme id="denominateur" label="Calcul de la part chaude" />
              </th>
              <td>Surface chaude ÷ superficie du QPV × 100</td>
            </tr>
            {[100, 300, 500].map((rayon) => (
              <tr>
                <th>Lieux ponctuels à {rayon} m</th>
                <td>
                  {
                    quartier[
                      `nombre_lieux_frais_${rayon}m` as "nombre_lieux_frais_300m"
                    ]
                  }{" "}
                  <Terme id="effectif" label="objets recensés" />
                </td>
              </tr>
            ))}
            <tr>
              <th colspan="2">
                Catégories à <span data-detail-distance>300</span> m
              </th>
            </tr>
            {Object.entries(quartier.comptes_300m).map(([famille, nombre]) => (
              <tr>
                <th>{famille}</th>
                <td data-detail-family={famille}>{nombre}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
    <p class="map-source text-[10px] mt-4 leading-[1.7] [&_a]:underline">
      Sources : ANCT, QPV 2024 ; Bordeaux Métropole, chaleur du 11 juillet 2022
      ; carte Espaces fraîcheur, extraction du 19 octobre 2026. Distances à vol
      d’oiseau. <a href="/sources/">Lire la méthode complète ↗</a>
    </p>
  </article>
</Layout>

<script src="../../scripts/dossier.ts"></script>
