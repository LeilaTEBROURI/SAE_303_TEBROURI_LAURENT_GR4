---
import "../styles/global.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/rubik-glitch";
import "@fontsource/special-elite";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChargementEnquete from "../components/ChargementEnquete.astro";
import VoleurDiscret from "../components/VoleurDiscret.astro";
const {
  title = "Qui a volé l’ombre ?",
  description = "Une enquête sur la chaleur et les lieux de fraîcheur dans les 23 quartiers prioritaires de Bordeaux Métropole.",
} = Astro.props;
---

<!doctype html>
<html lang="fr" data-theme="enquete">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Restaurer la préférence avant l’affichage pour éviter un clignotement.
      try {
        if (localStorage.getItem("enquete-mode-loupe") === "active") {
          document.documentElement.dataset.modeLoupe = "active";
        }
      } catch {
        // Le mode reste utilisable même si le stockage est bloqué.
      }
    </script>
    <link rel="icon" href="/illustrations/e5f05.svg" type="image/svg+xml" />
  </head>
  <body
    class:list={[
      "[&.inner-page_>_.container]:w-[min(1400px,_calc(100%_-_160px))] max-[760.001px]:[&.inner-page_>_.container]:w-[calc(100%_-_64px)]",
      { "inner-page": Astro.url.pathname !== "/" },
    ]}
  >
    <a
      class="skip-link fixed top-[10px] left-[10px] [transform:translateY(-200%)] z-[5000] bg-primary text-ink pt-3 pr-3 pb-3 pl-3 [&:focus]:[transform:none]"
      href="#contenu"
    >
      Aller au contenu
    </a>
    <Header />
    {Astro.url.pathname !== "/" && <VoleurDiscret />}
    <main
      id="contenu"
      class="container w-[min(1400px,_calc(100%_-_96px))] max-[760.001px]:w-[calc(100%_-_36px)] min-[760.001px]:max-[1100.001px]:w-[calc(100%_-_56px)] ml-auto mr-auto"
    >
      <slot />
    </main>
    <Footer />
    <ChargementEnquete />
    <div id="spotlight" aria-hidden="true"></div>
    <script src="../scripts/mode-loupe.ts"></script>
  </body>
</html>
