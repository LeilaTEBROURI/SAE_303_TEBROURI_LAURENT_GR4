---
import { glossaire } from "../data/glossaire";
interface Props {
  id: string;
  label?: string;
}
const { id, label } = Astro.props;
const terme = glossaire.find((terme) => terme.id === id);
if (!terme) throw new Error(`Définition absente du glossaire : ${id}`);
const texte = label ?? terme.mot;
---

<a
  class="glossary-term text-[inherit] [text-decoration:underline_dotted] [text-underline-offset:0.22em] [text-decoration-thickness:1px] [&:hover]:[text-decoration-style:solid] [&:focus-visible]:[text-decoration-style:solid]"
  href={`/glossaire/#${id}`}
  aria-label={`${texte} : ${terme.complet ?? terme.mot}. Lire la définition.`}
>
  {texte}
</a>
