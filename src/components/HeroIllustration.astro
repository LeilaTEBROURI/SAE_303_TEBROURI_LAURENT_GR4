<script>
  const art = document.querySelector<HTMLElement>(".hero-art");
  if (art) {
    const observer = new ResizeObserver(() =>
      art.style.setProperty("--art-scale", String(art.clientWidth / 768)),
    );
    observer.observe(art);
  }
</script>
