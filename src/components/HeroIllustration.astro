---
import quartiers from "../assets/synthese-notebook.json";
const majoriteChaude = quartiers.filter((q) => q.part_chaude_pct > 50).length;
const sansLieu = quartiers.filter((q) => q.nombre_lieux_frais === 0).length;
const indices = [
  {
    valeur: String(quartiers.length),
    titre: "quartiers étudiés",
    detail: "Les quartiers prioritaires de Bordeaux Métropole.",
    couleur: "text-ink",
  },
  {
    valeur: String(majoriteChaude),
    titre: "quartiers majoritairement chauds",
    detail: "Plus de 50 % de leur surface est classée chaude.",
    couleur: "text-[#b34d25]",
  },
  {
    valeur: String(sansLieu),
    titre: "quartier sans lieu frais recensé",
    detail: "Dans le quartier ou à moins de 300 m de son contour.",
    couleur: "text-[#60457b]",
  },
  {
    valeur: "300 m",
    titre: "pour explorer les alentours",
    detail: "La distance de référence de notre recherche.",
    couleur: "text-[#2d7e9e]",
  },
];
---

<figure class="hero-art max-[1500.001px]:max-w-none w-[calc(100%_-_60px)] max-[760.001px]:w-full aspect-[768/570] relative max-[760.001px]:mt-1 max-w-[768px] text-ink [container-type:inline-size]">
  <div class="absolute bg-gold left-[1.56%] top-[7.72%] w-[96.88%] h-[89.12%] rounded-[8px]"></div>
  <div class="absolute left-[3.65%] top-[3.16%] w-[32.55%] h-[6.32%] rounded-t-[16px] bg-gold"></div>
  <div class="absolute left-[3.91%] top-[9.65%] w-[92.19%] h-[81.75%] bg-cream"></div>
  <div class="absolute left-[7%] top-[14%] w-[86%]">
    <p class="uppercase tracking-[0.15em] text-[1.7cqw] font-bold text-[#765221]">
      Les premières pièces du dossier
    </p>
    <h2 class="font-typewriter text-[3.5cqw] leading-[1.2] mt-[1.5cqw] mb-[2cqw]">
      L’enquête en 4 chiffres.
    </h2>
    <dl class="grid grid-cols-2 gap-[1.5cqw]">
      {indices.map((indice) => (
        <div class="bg-[#f6efdb] border border-[#e4dbc5] rounded-[1cqw] p-[1.7cqw]">
          <dd
            class:list={[
              "font-bold text-[6cqw] leading-none mb-[0.8cqw]",
              indice.couleur,
            ]}
          >
            {indice.valeur}
          </dd>
          <dt class="font-bold text-[1.85cqw] leading-[1.25]">
            {indice.titre}
          </dt>
          <dd class="text-[1.5cqw] leading-[1.4] mt-[0.7cqw] text-[#65615b]">
            {indice.detail}
          </dd>
        </div>
      ))}
    </dl>
    <p class="text-[1.5cqw] leading-[1.4] mt-[1.3cqw] text-[#65615b]">
      Un zéro ne signifie pas « aucune fraîcheur » : l’inventaire ne garantit ni
      l’ouverture ni l’accès aux lieux.
    </p>
  </div>
  <span class="absolute left-[67.7%] top-[6.67%] border-2 border-[#a73d30] text-[#a73d30] py-[6px] px-3 -rotate-5 text-[clamp(10px,1.1vw,18px)] z-[1] pointer-events-none">
    À EXAMINER
  </span>
  <figcaption class="absolute left-[7%] top-[86%] w-[86%] text-[1.5cqw] leading-[1.4] text-[#65615b]">
    Sources : ANCT, quartiers 2024 · Bordeaux Métropole, chaleur du 11/07/2022 ·
    Espaces fraîcheur, extraction du 19/10/2026.
    <a href="/sources/" class="underline underline-offset-2">
      Lire la méthode ↗
    </a>
  </figcaption>
</figure>
<div
  class="thief absolute right-[calc(50%_-_50vw)] top-[100px] max-[760.001px]:top-[80px] w-[92px] max-[760.001px]:w-[60px] h-[274px] max-[760.001px]:h-[179px] pointer-events-none z-[3] [transform:none] max-[760.001px]:[transform-origin:right_top]"
  aria-hidden="true"
>
  <img
    class="thief-body [transform:none] w-[92px] max-[760.001px]:w-[60px] h-[274px] max-[760.001px]:h-[179px] object-contain"
    src="/illustrations/voleur.avif"
    width="92"
    height="274"
    alt=""
  />
</div>
