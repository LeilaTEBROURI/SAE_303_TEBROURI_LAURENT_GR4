---
import Terme from "./Terme.astro";
import quartiers from "../assets/indicateurs.json";
import "leaflet/dist/leaflet.css";
const { code = "", detail = false } = Astro.props;
---

<section
  class:list={[
    "explorer bg-cream text-ink rounded-[12px] pt-[25px] max-[760.001px]:pt-[18px] pr-[25px] max-[760.001px]:pr-[18px] pb-[25px] max-[760.001px]:pb-[18px] pl-[25px] max-[760.001px]:pl-[18px] mb-7 [&_.section-head]:mb-5 [&.detail-explorer]:pt-0 [&.detail-explorer]:pr-0 [&.detail-explorer]:pb-0 [&.detail-explorer]:pl-0 [&.detail-explorer]:mt-[30px] [&.detail-explorer_.section-head_h2]:text-[23px] [&.detail-explorer_.leaflet-map]:h-[530px] max-[760.001px]:[&.detail-explorer_.leaflet-map]:h-[440px] [&.detail-explorer_.selected-panel]:bg-[#f6efdb] [&.detail-explorer_.selected-panel]:text-ink [&.detail-explorer_.selected-panel_.muted]:text-[#65615b] [&.detail-explorer_.selected-panel_.panel-note]:text-[#65615b] [&.detail-explorer_.distance-field_>_p]:text-[#65615b] [&.detail-explorer_.panel-metric_span]:text-[#65615b] [&.detail-explorer_.eyebrow]:text-[#765221] [&.detail-explorer_.selected-panel_>_h3]:hidden [&.detail-explorer_.selected-panel_>_.muted]:hidden [&.detail-explorer_.selected-panel_>_hr]:hidden [&.detail-explorer_.panel-metric]:hidden [&.detail-explorer_.radius-choice]:[border:1px_solid_#d9cfae] [&_.leaflet-map]:bg-[#f6efdb]",
    { "detail-explorer": detail },
  ]}
  data-explorer
  data-code={code}
  data-detail={String(detail)}
  aria-labelledby="carte-title"
>
  <div class="section-head flex justify-between items-center max-[760.001px]:items-start gap-[25px] max-[760.001px]:gap-[18px] mb-[30px] max-[760.001px]:flex-col [&_h2]:text-[28px] max-[760.001px]:[&_h2]:text-[25px] [&_h2]:font-bold [&_h2]:leading-[1.3] [&_p]:text-[14px] max-[760.001px]:[&_p]:text-[13px]">
    <div>
      <h2 id="carte-title">
        {detail ? "Localiser les indices" : "À toi de mener l’enquête"}
      </h2>
      <p class="mt-2">
        {detail
          ? "Observe les surfaces chaudes et les lieux recensés aux alentours."
          : "Choisis un quartier sur la carte ou dans la liste, puis ouvre son dossier."}
      </p>
    </div>
    {!detail && (
      <a
        class="btn btn-neutral font-semibold normal-case shadow-none text-cream bg-ink"
        href="/#dossiers"
      >
        Les 23 dossiers ↗
      </a>
    )}
  </div>
  <div class="map-controls flex flex-wrap items-center gap-[10px] max-[760.001px]:gap-2 mb-5">
    <label class="layer-pill flex gap-2 items-center pt-[11px] max-[760.001px]:pt-[9px] pr-[14px] max-[760.001px]:pr-[9px] pb-[11px] max-[760.001px]:pb-[9px] pl-[14px] max-[760.001px]:pl-[9px] bg-[#60457b] text-cream rounded-[5px] text-[12px] max-[760.001px]:text-[10px] font-semibold cursor-pointer">
      <input
        class="checkbox checkbox-xs"
        type="checkbox"
        data-layer="quartiers"
        checked
      />{" "}
      Quartiers
    </label>
    <label class="layer-pill heat-pill flex gap-2 items-center pt-[11px] max-[760.001px]:pt-[9px] pr-[14px] max-[760.001px]:pr-[9px] pb-[11px] max-[760.001px]:pb-[9px] pl-[14px] max-[760.001px]:pl-[9px] bg-[#b34d25] text-cream rounded-[5px] text-[12px] max-[760.001px]:text-[10px] font-semibold cursor-pointer">
      <input
        class="checkbox checkbox-xs"
        type="checkbox"
        data-layer="chaleur"
        checked
      />{" "}
      Surfaces chaudes
    </label>
    <label class="layer-pill places-pill flex gap-2 items-center pt-[11px] max-[760.001px]:pt-[9px] pr-[14px] max-[760.001px]:pr-[9px] pb-[11px] max-[760.001px]:pb-[9px] pl-[14px] max-[760.001px]:pl-[9px] bg-[#2c6d4b] text-cream rounded-[5px] text-[12px] max-[760.001px]:text-[10px] font-semibold cursor-pointer">
      <input
        class="checkbox checkbox-xs"
        type="checkbox"
        data-layer="lieux"
        checked
      />{" "}
      Lieux recensés
    </label>
    {!detail && (
      <label class="quartier-select [flex:1] min-w-[230px] max-[760.001px]:w-full max-[760.001px]:basis-[100%] [&_select]:w-full [&_select]:bg-[#f6efdb]">
        <span class="sr-only">Choisir un quartier</span>
        <select class="select text-[16px] leading-[1.6]" data-quartier>
          <option value="">Toute la métropole</option>
          {quartiers.map((q) => (
            <option value={q.code_qp} selected={q.code_qp === code}>
              {q.quartier} · {q.communes}
            </option>
          ))}
        </select>
      </label>
    )}
    <button
      class="btn btn-sm btn-ghost text-[16px] leading-[1.6] font-semibold normal-case shadow-none"
      data-reset
      type="button"
    >
      Vue générale ↗
    </button>
  </div>
  <div class="map-layout grid grid-cols-[minmax(0,_2.3fr)_minmax(280px,_1fr)] max-[760.001px]:grid-cols-1 min-[760.001px]:max-[1100.001px]:grid-cols-[minmax(0,_1.6fr)_280px] gap-[22px]">
    <figure style="margin:0;min-width:0">
      <div
        class="leaflet-map h-[620px] max-[760.001px]:h-[440px] min-[760.001px]:max-[1100.001px]:h-[600px] bg-[#f6efdb] rounded-[8px] z-0"
        data-map
        role="region"
        aria-label="Carte interactive des quartiers et des lieux de fraîcheur"
        tabindex="0"
      ></div>
      <figcaption class="map-hint text-[10px] mt-2 text-[#65615b]">
        + / − pour zoomer · Glisse pour te déplacer · Clique un quartier pour
        ouvrir ses indices · Survole un lieu pour lire sa fiche (touche-le sur
        mobile). Orange : surface chaude ; violet : contour des QPV. Les
        chiffres et catégories sont disponibles dans le panneau et les dossiers.
      </figcaption>
    </figure>
    <aside
      class="selected-panel bg-ink text-cream pt-[26px] max-[760.001px]:pt-[22px] min-[760.001px]:max-[1100.001px]:pt-5 pr-[26px] max-[760.001px]:pr-[22px] min-[760.001px]:max-[1100.001px]:pr-5 pb-[26px] max-[760.001px]:pb-[22px] min-[760.001px]:max-[1100.001px]:pb-5 pl-[26px] max-[760.001px]:pl-[22px] min-[760.001px]:max-[1100.001px]:pl-5 rounded-[8px] flex flex-col gap-[15px] [&_.eyebrow]:mt-0 [&_.eyebrow]:mr-0 [&_.eyebrow]:mb-0 [&_.eyebrow]:ml-0 [&_h3]:text-[28px] max-[760.001px]:[&_h3]:text-[27px] [&_h3]:leading-[1.2] [&_h3]:font-bold [&_>_.muted]:text-[12px] [&_hr]:[border-top:1px_solid_#777268] [&_hr]:mt-[3px] [&_hr]:mb-[3px]"
      aria-live="polite"
    >
      <p class="eyebrow uppercase tracking-[0.12em] text-[11px] font-bold text-primary mb-[18px]">
        Dossier sélectionné
      </p>
      <h3 data-nom></h3>
      <p class="muted text-muted" data-commune></p>
      <hr />
      <div class="panel-metric [&_strong]:block [&_strong]:text-[27px] [&_strong]:font-bold [&_span]:text-[12px] [&_span]:text-muted">
        <strong data-chaud></strong>
        <span>de surface chaude dans le QPV</span>
      </div>
      <fieldset class="distance-field [&_legend]:text-[13px] [&_legend]:font-semibold [&_legend]:mb-2 [&_.join]:w-full [&_>_p]:text-[10px] [&_>_p]:text-muted [&_>_p]:mt-2">
        <legend>Chercher les lieux à proximité</legend>
        <div class="join">
          {[100, 300, 500].map((rayon) => (
            <label class="btn btn-sm join-item radius-choice font-semibold normal-case shadow-none bg-[#f6efdb] text-ink [border:none] [flex:1] min-w-0 pl-2 pr-2 max-[760.001px]:min-h-[40px] [&:has(input:checked)]:bg-primary [&_input]:absolute [&_input]:opacity-0 [&_input]:w-[1px] [&_input]:h-[1px] [&:has(input:focus-visible)]:[outline:3px_solid_#2d7e9e] [&:has(input:focus-visible)]:[outline-offset:3px]">
              <input
                type="radio"
                name="distance"
                value={rayon}
                checked={rayon === 300}
              />
              <span>{rayon} m</span>
            </label>
          ))}
        </div>
        <p class="panel-note text-[10px] text-muted mt-auto">
          300 m : référence du notebook. 100 et 500 m : exploration ajoutée au
          site.
        </p>
      </fieldset>
      <dl
        class="counts text-[12px] max-[760.001px]:text-[13px] grid gap-2 [&_>_div]:flex [&_>_div]:justify-between [&_>_div]:gap-[15px] [&_dd]:font-bold"
        data-counts
      ></dl>
      <a
        class="btn btn-primary font-semibold normal-case shadow-none text-ink bg-primary [&:hover]:bg-[#ffd57c]"
        data-open
        href="#"
      >
        Ouvrir ce dossier →
      </a>
      <p class="panel-note text-[10px] text-muted mt-auto">
        Un zéro signifie « aucun lieu ponctuel retenu ». Les parcs dessinés en
        <Terme id="polygone" label="polygones" /> sont exclus du comptage.
        Présence, gratuité et ouverture sont à vérifier sur place.
      </p>
    </aside>
  </div>
  <p class="map-word-help text-[12px] leading-[1.6] mt-[15px] mb-[15px]">
    Un <Terme id="ponctuel" label="lieu ponctuel" /> est représenté par un
    point. Les distances sont mesurées{" "}
    <Terme id="vol-oiseau" label="à vol d’oiseau" /> autour du quartier.
  </p>
  <div class="map-legend flex flex-wrap gap-[12px_23px] max-[760.001px]:gap-[10px] text-[11px] max-[760.001px]:text-[10px] mt-[21px] [&_span]:flex [&_span]:items-center [&_span]:gap-[6px] [&_i]:w-[10px] [&_i]:h-[10px] [&_i]:rounded-full">
    <span>
      <i style="background:#de6d37"></i>{" "}
      <Terme id="delta" label="Surface chaude (écart ≥ +3 °C)" />
    </span>
    <span>
      <i style="background:#60457b"></i> Contour d’un <Terme id="qpv" />
    </span>
    <span>
      <i style="background:#2c6d4b"></i> Espace végétalisé
    </span>
    <span>
      <i style="background:#2d7e9e"></i> Eau / baignade
    </span>
    <span>
      <i style="background:#7c6995"></i> Bâtiment
    </span>
  </div>
  <p class="map-source text-[10px] mt-4 leading-[1.7] [&_a]:underline">
    Chaleur : 11 juillet 2022 · QPV : 2024 · Lieux : inventaire extrait le 19
    octobre 2026. Le gris représente le contour de Bordeaux Métropole. Le
    comptage porte sur les lieux ponctuels à la distance choisie.
  </p>
  <noscript>
    <p>
      Active JavaScript pour explorer la carte. Tous les chiffres restent
      disponibles dans les <a href="/#dossiers">dossiers des quartiers</a>.
    </p>
  </noscript>
</section>
<script src="../scripts/carte.ts"></script>
